{
  "name": "cookie-sync",
  "version": "0.0.0",
  "description": "Sync cookies for local frontend development of sentry.io",
  "private": true,
  "repository": "https://github.com/getsentry/cookie-sync.git",
  "author": {
    "name": "Ryan Albrecht",
    "email": "ryan.albrecht@sentry.io"
  },
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "addfox dev -b chrome",
    "dev:chrome": "addfox dev -b chrome",
    "dev:firefox": "addfox dev -b firefox",
    "build:chrome": "addfox build -b chrome --no-open",
    "build:firefox": "addfox build -b firefox --no-open",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "test": "addfox test",
    "test:coverage": "addfox test --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/browser": "^7.39.0",
    "@sentry/react": "^7.39.0",
    "@sentry/tracing": "^7.39.0",
    "@total-typescript/ts-reset": "^0.3.7",
    "advanced-css-reset": "^1.2.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "semver-compare": "^1.0.0",
    "serialize-error": "^11.0.0",
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@abhijithvijayan/eslint-config": "2.6.3",
    "@abhijithvijayan/eslint-config-airbnb": "^1.0.2",
    "@rsbuild/plugin-react": "^1.4.6",
    "@rstest/core": "^0.9.4",
    "@types/node": "^18.19.87",
    "@types/react": "^17.0.6",
    "@types/react-dom": "^17.0.5",
    "@types/semver-compare": "^1.0.1",
    "@types/webextension-polyfill": "^0.9.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "addfox": "^0.1.1-beta.10",
    "autoprefixer": "^10.4.8",
    "cssnano": "^5.1.13",
    "eslint": "^7.27.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.23.3",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.23.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "postcss": "^8.4.16",
    "postcss-import": "^14.1.0",
    "prettier": "^2.3.0",
    "typescript": "4.7.4"
  }
}
