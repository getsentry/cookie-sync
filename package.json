{
  "name": "cookie-sync",
  "version": "0.0.0",
  "description": "Sync cookies for local frontend development of sentry.io",
  "private": true,
  "repository": "https://github.com/getsentry/cookie-sync.git",
  "author": {
    "name": "Ryan Albrecht",
    "email": "ryan.albrecht@sentry.io"
  },
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit": "wxt submit",
    "postinstall": "wxt prepare",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/browser": "^7.39.0",
    "@sentry/react": "^7.39.0",
    "@sentry/tracing": "^7.39.0",
    "@total-typescript/ts-reset": "^0.3.7",
    "advanced-css-reset": "^1.2.2",
    "emoji-log": "^1.0.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "semver-compare": "^1.0.0",
    "serialize-error": "^11.0.0",
    "webext-base-css": "^1.3.1"
  },
  "devDependencies": {
    "@wxt-dev/module-react": "^1.1.2",
    "@types/react": "^17.0.6",
    "@types/react-dom": "^17.0.5",
    "@types/semver-compare": "^1.0.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "autoprefixer": "^10.4.8",
    "cssnano": "^5.1.13",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.16",
    "postcss-import": "^14.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "wxt": "^0.20.18"
